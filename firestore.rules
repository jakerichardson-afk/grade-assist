rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All access goes through the gradeEssay/cleanupExpiredJobs Cloud
    // Functions (Admin SDK, bypasses these rules). No direct client
    // reads/writes are ever allowed, signed in or not.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
